# Base URL for the Block Forge backend API (see sibling `backend` repo).
API_BASE_URL=https://api.blockforge.example.com

# Toggle verbose network/query logging in dev builds.
API_DEBUG_LOGGING=false

# Analytics / crash reporting keys (leave blank to disable in dev).
ANALYTICS_WRITE_KEY=

# Feature flags
FEATURE_DAILY_CHALLENGE=true
FEATURE_LEADERBOARD=true
FEATURE_SHOP=true
